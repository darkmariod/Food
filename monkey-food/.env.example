# Configuración de Admin
# Cambiá estos valores para seguridad

# Usuario para acceder al admin (por defecto: admin)
ADMIN_USER=admin

# Contraseña del admin (cambiala!)
ADMIN_PASS=monkey2024

# URL de Supabase (opcional - si usás Supabase)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key

# Tu número de WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=593968464331

# === OpenWA (WhatsApp Gateway) ===
# Configuración del gateway OpenWA para el bot de WhatsApp
OPENWA_BASE_URL=http://localhost:2886
OPENWA_API_KEY=monkey_food_secure_key
OPENWA_SESSION_ID=default

# === n8n ===
# URL del webhook de n8n que recibe mensajes desde OpenWA
N8N_WEBHOOK_URL=http://localhost:5678/webhook/monkey-food-whatsapp